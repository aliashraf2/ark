# ARK Colab wrapper configuration template.
# Copy to .ark-colab.env at the repo root (git-ignored) and adjust, or export
# the same variables in your shell. Never put tokens in this file.
#
#   cp scripts/ark-colab.env.example .ark-colab.env

# Colab CLI binary (override for testing with a mock).
ARK_COLAB_BIN=colab

# Session name reused across commands (always explicit; never auto-generated).
ARK_COLAB_SESSION=ark-trainer

# Accelerator for `start`: cpu (default) or T4 L4 G4 H100 A100.
ARK_RUNTIME=cpu

# TPU variant instead of GPU: v5e1 or v6e1 (leave empty for none).
ARK_COLAB_TPU=

# High-RAM machine shape: 0 or 1 (needs Pro/Pro+ for most shapes).
ARK_COLAB_HIGH_MEM=0

# Notebook to upload and run (absolute, or relative to the repo root).
ARK_NOTEBOOK=services/training/notebooks/ARK_Colab_Setup.ipynb

# Remote destination root on the Colab VM (temporary disk).
ARK_REMOTE_DIR=/content/ark

# Local directory for runs, logs, downloads. Default (when unset) is
# <repo>/artifacts/colab; any override should be an absolute path.
# ARK_OUTPUT_DIR=/path/to/ARK/artifacts/colab

# Remote execution timeout, seconds (CLI default is only 30).
ARK_COLAB_TIMEOUT=1800

# CLI auth strategy: empty (CLI default), oauth2 (browser), or adc (gcloud).
ARK_COLAB_AUTH=
