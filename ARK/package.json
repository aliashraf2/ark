{
  "name": "ark",
  "version": "0.1.0",
  "description": "ARK (Autonomous Reality Kernel) monorepo root.",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/simulator",
    "packages/physics",
    "packages/rl"
  ],
  "scripts": {
    "rover:train": "tsx services/training/trainRoverQ.ts",
    "rover:dev": "bash scripts/dev-rover.sh",
    "bridge:smoke": "uv run --project services/training/python --group dev services/training/python/examples/smoke_test.py",
    "bridge:test": "uv run --project services/training/python --group dev pytest -q services/training/python/tests --rootdir services/training/python",
    "colab:verify": "uv run --project services/training/python --group dev services/training/scripts/verify_colab.py --stage all",
    "rl:benchmark": "tsx services/training/benchmark/rlBenchmark.ts",
    "rl:smoke": "tsx services/training/examples/randomAgent.ts",
    "sim:headless": "tsx services/training/headless/main.ts",
    "simulator": "npm --workspace apps/simulator run dev",
    "test": "npm --workspace apps/simulator run test"
  },
  "devDependencies": {
    "tsx": "^4.19.0"
  }
}
