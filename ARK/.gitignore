# Secrets — never commit real keys.
.env
*.env
!.env.example
**/.env
!**/.env.example

# ARK agent runtime state (planner transcripts, approved capabilities cache).
services/agent/data/

# Python
__pycache__/
*.py[cod]
.venv/

# Node / build
node_modules/
dist/

# Colab diagnostic artifacts (regenerated per run).
colab_artifacts/

# ark-colab.sh local runs, logs, downloads, and session pointer (no creds).
artifacts/

# Deployment state/credentials are local only. Commit the provider lock file.
.deploy/
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tfvars
*.tfvars.json
crash.log
.dev-rover/
