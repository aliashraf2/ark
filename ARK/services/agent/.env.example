# ARK Mission Control backend configuration (copy to .env and fill in).
# Never commit real keys. The frontend bundle must never contain secrets.
# Easiest path: paste your key in the simulator's Mission AI tab (Agent Link
# setup) — the backend validates it and writes this file for you.

# Google AI Studio key (Gemini). Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional Gemini model override (default: gemini-2.5-flash).
GEMINI_MODEL=

# ...or use Anthropic instead.
ANTHROPIC_API_KEY=

# Optional Anthropic model override.
ANTHROPIC_MODEL=

# ...or use Meta Muse. Dashboard: Agent Link > Provider > Muse (Meta).
MUSE_API_KEY=
MUSE_MODEL=muse-spark-1.3
# The dashboard remembers the selected provider after validating its key.
# ARK_LLM_PROVIDER=muse

# Optional ElevenLabs voice adapter. Keep these ONLY in the backend .env.
# Choose a voice ID available in your ElevenLabs account (Voices > copy voice ID).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Scribe v2 Realtime is fixed for STT. This is the configurable TTS model.
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# English is the only enabled/tested language in this integration.
ELEVENLABS_LANGUAGE=en

# Comma-separated browser origins allowed to call this service.
# When unset, any http(s) localhost origin is accepted (dev default).
# ARK_CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Optional overrides (defaults shown).
# ARK_PROTOCOL_PATH=../../packages/shared/world-commands.json
# ARK_AGENT_DATA=./data
# AGENT_PORT=8000
